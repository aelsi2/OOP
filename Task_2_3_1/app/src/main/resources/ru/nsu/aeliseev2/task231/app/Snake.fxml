<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import ru.nsu.aeliseev2.task231.app.drawing.TileMap?>
<?import ru.nsu.aeliseev2.task231.app.Palettes?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.nsu.aeliseev2.task231.app.SnakeController"
      prefHeight="400.0" prefWidth="600.0"
      style="-fx-background-color: #396b2e;">
    <Label StackPane.alignment="TOP_LEFT" textFill="white"
           fx:id="score">
        <padding>
            <Insets left="40" right="40" top="10" bottom="10"/>
        </padding>
        <font>
            <Font name="System Bold" size="40.0"/>
        </font>
    </Label>
    <StackPane VBox.vgrow="ALWAYS">
        <padding>
            <Insets left="40" right="40" bottom="40"/>
        </padding>
        <TileMap fx:id="background">
            <palette>
                <Palettes fx:constant="BACKGROUND_GRASS"/>
            </palette>
        </TileMap>
        <TileMap fx:id="foreground">
            <palette>
                <Palettes fx:constant="FOREGROUND_BLUE_RED"/>
            </palette>
        </TileMap>
    </StackPane>
</VBox>
