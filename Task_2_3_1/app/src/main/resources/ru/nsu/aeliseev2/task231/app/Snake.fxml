<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.StackPane?>
<?import ru.nsu.aeliseev2.task231.app.drawing.TileMap?>
<?import ru.nsu.aeliseev2.task231.app.Palettes?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Button?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.nsu.aeliseev2.task231.app.SnakeController"
      prefHeight="400.0" prefWidth="600.0"
      style="-fx-background-color: #396b2e;">
    <Label StackPane.alignment="TOP_LEFT" textFill="white"
           fx:id="score">
        <padding>
            <Insets left="40" right="40" top="10" bottom="10"/>
        </padding>
        <font>
            <Font name="System Bold" size="40.0"/>
        </font>
    </Label>
    <StackPane VBox.vgrow="ALWAYS">
        <padding>
            <Insets left="40" right="40" bottom="40"/>
        </padding>
        <TileMap fx:id="background">
            <palette>
                <Palettes fx:constant="BACKGROUND_GRASS"/>
            </palette>
        </TileMap>
        <TileMap fx:id="foreground">
            <palette>
                <Palettes fx:constant="FOREGROUND_BLUE_RED"/>
            </palette>
        </TileMap>
        <GridPane maxHeight="-Infinity" maxWidth="200" StackPane.alignment="CENTER"
                  hgap="5" vgap="5"
                  fx:id="menu">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints prefWidth="100" hgrow="NEVER"/>
            </columnConstraints>
            <Label GridPane.rowIndex="0" GridPane.columnIndex="0" text="Width"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Spinner GridPane.rowIndex="0" GridPane.columnIndex="1"
                     min="8" max="20" initialValue="10"
                     fx:id="widthSpinner"/>
            <Label GridPane.rowIndex="1" GridPane.columnIndex="0" text="Height"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Spinner GridPane.rowIndex="1" GridPane.columnIndex="1"
                     min="8" max="20" initialValue="10"
                     fx:id="heightSpinner"/>
            <Label GridPane.rowIndex="2" GridPane.columnIndex="0" text="Food"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Spinner GridPane.rowIndex="2" GridPane.columnIndex="1"
                     min="1" max="10" initialValue="3"
                     fx:id="foodSpinner"/>
            <Label GridPane.rowIndex="3" GridPane.columnIndex="0" text="Speed"
                   style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Spinner GridPane.rowIndex="3" GridPane.columnIndex="1"
                     min="1" max="8" initialValue="3"
                     fx:id="speedSpinner"/>
            <Button GridPane.rowIndex="4" GridPane.columnSpan="2" maxWidth="Infinity"
                    text="Start"
                    onAction="#onStartClick"/>
        </GridPane>
    </StackPane>
</VBox>
